{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LUMI ML Workflow Benchmark Result",
  "type": "object",
  "required": ["schema_version", "timestamp_utc", "run_id", "workload", "metrics"],
  "properties": {
    "schema_version": {"type": "string"},
    "timestamp_utc": {"type": "string"},
    "run_id": {"type": "string"},
    "container": {
      "type": "object",
      "properties": {
        "image_path": {"type": "string"},
        "image_digest": {"type": "string"}
      }
    },
    "slurm": {
      "type": "object",
      "properties": {
        "nodes": {"type": "integer"},
        "ntasks": {"type": "integer"},
        "gpus_per_node": {"type": "integer"},
        "cpus_per_task": {"type": "integer"}
      }
    },
    "system": {
      "type": "object",
      "properties": {
        "hostname_list": {"type": "array", "items": {"type": "string"}},
        "partition": {"type": "string"},
        "rocm_version": {"type": "string"}
      }
    },
    "workload": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"type": "string"},
        "model": {"type": "string"},
        "dtype": {"type": "string"}
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "tokens_per_sec": {"type": "number"},
        "samples_per_sec": {"type": "number"},
        "step_time_ms_avg": {"type": "number"},
        "step_time_ms_p95": {"type": "number"},
        "gpu_max_mem_gb": {"type": "number"},
        "host_mem_gb": {"type": "number"},
        "latency_ms_per_token": {"type": "number"},
        "latency_ms_per_sample": {"type": "number"},
        "allreduce_time_ms_avg": {"type": "number"},
        "allreduce_time_ms_total": {"type": "number"},
        "allreduce_bytes_total": {"type": "number"}
      }
    }
  }
}
